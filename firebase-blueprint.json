{
  "entities": {
    "Enquiry": {
      "title": "Studio Enquiry",
      "description": "Private student admission enquiries, trial demo requests, and portrait commission enquiries.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "email": {
          "type": "string",
          "maxLength": 200
        },
        "phone": {
          "type": "string",
          "minLength": 3,
          "maxLength": 60
        },
        "serviceCategory": {
          "type": "string",
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "enum": ["new", "contacted", "reviewed", "resolved"]
        },
        "message": {
          "type": "string",
          "maxLength": 4000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "phone", "status", "createdAt"]
    }
  },
  "firestore": {
    "/enquiries/{enquiryId}": {
      "schema": {
        "$ref": "#/entities/Enquiry"
      },
      "description": "Private student/client enquiries accessible only to authorized studio admins."
    }
  }
}
