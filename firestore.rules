rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_.\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'vikasgothi888@gmail.com'
      );
    }

    function isValidEnquiry(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'status', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'createdAt', 'name', 'email', 'phone', 'serviceCategory',
          'serviceDetail', 'countryOrCity', 'studentAge', 'timeSlotPreference',
          'message', 'status'
        ])
        && data.id is string && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 150
        && data.phone is string && data.phone.size() >= 3 && data.phone.size() <= 60
        && data.status is string && data.status in ['new', 'contacted', 'reviewed', 'resolved']
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Boot Connection Probe (read-only ping document)
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // Admin Allowlist (server-managed only)
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    // Private PII Collection: Enquiries (Strict Admin Only)
    match /enquiries/{enquiryId} {
      allow get: if isAdmin() && isValidId(enquiryId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(enquiryId) && isValidEnquiry(incoming());
      allow update: if isAdmin() && isValidId(enquiryId) && isValidEnquiry(incoming())
        && incoming().createdAt == resource.data.createdAt
        && incoming().diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if isAdmin() && isValidId(enquiryId);
    }
  }
}
