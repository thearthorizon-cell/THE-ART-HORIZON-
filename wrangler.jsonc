{
  "name": "the-art-horizon",
  "main": "worker.ts",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "STUDIO_KV",
      "id": "2011b3b4af7542328d4a343eb1851db3"
    }
  ]
}
